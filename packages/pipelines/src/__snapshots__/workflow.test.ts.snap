exports[`the shipped workflows bun-app renders with its defaults 1`] = `
"# Generated by orch from template bun-app@1.0.0. Change the pipeline there: edits here are overwritten.
name: bun-app
"on":
  pull_request: {}
  push: {}
permissions:
  contents: read
jobs:
  typecheck:
    if: github.event_name == 'pull_request' || github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    container: oven/bun:1
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - run: bun install --frozen-lockfile
      - run: bun run typecheck
  lint:
    if: github.event_name == 'pull_request' || github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    container: oven/bun:1
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - run: bun install --frozen-lockfile
      - run: bun run lint
  test:
    if: github.event_name == 'pull_request' || github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    container: oven/bun:1
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - run: bun install --frozen-lockfile
      - run: bun run test
  build:
    if: github.event_name == 'pull_request' || github.ref_name == github.event.repository.default_branch
    needs:
      - typecheck
      - lint
      - test
    runs-on: ubuntu-latest
    container: oven/bun:1
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - run: bun install --frozen-lockfile
      - run: bun run build
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: build
          path: dist/
          retention-days: 7
"
`;

exports[`the shipped workflows docker-image renders with its defaults 1`] = `
"# Generated by orch from template docker-image@1.0.0. Change the pipeline there: edits here are overwritten.
name: docker-image
"on":
  pull_request: {}
  push: {}
permissions:
  contents: read
jobs:
  build:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - run: docker build --pull -f "Dockerfile" "."
  publish:
    if: github.event_name == 'push' && github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - env:
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -eu
          image="ghcr.io/$(printf %s "$GITHUB_REPOSITORY" | tr '[:upper:]' '[:lower:]')"
          tag="$(printf %s "$GITHUB_SHA" | cut -c1-8)"
          printf %s "$REGISTRY_TOKEN" | docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
          docker build --pull -f "Dockerfile" -t "$image:$tag" -t "$image:latest" "."
          docker push "$image:$tag"
          docker push "$image:latest"
"
`;

exports[`the shipped workflows node-app renders with its defaults 1`] = `
"# Generated by orch from template node-app@1.0.0. Change the pipeline there: edits here are overwritten.
name: node-app
"on":
  pull_request: {}
  push: {}
permissions:
  contents: read
jobs:
  typecheck:
    if: github.event_name == 'pull_request' || github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    container: node:22
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - run: npm ci
      - run: npm run typecheck
  lint:
    if: github.event_name == 'pull_request' || github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    container: node:22
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
