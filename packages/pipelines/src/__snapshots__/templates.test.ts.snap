default:
  image: oven/bun:1
  cache:
    key:
      files:
        - bun.lock
    paths:
      - node_modules/
  before_script:
    - bun install --frozen-lockfile
stages:
  - check
  - build
typecheck:
  stage: check
  script:
    - bun run typecheck
lint:
  stage: check
  script:
    - bun run lint
test:
  stage: check
  script:
    - bun run test
build:
  stage: build
  script:
    - bun run build
  artifacts:
    paths:
      - dist/
    expire_in: 1 week
secret_detection:
  stage: check
  inherit:
    default: false
"
`;

