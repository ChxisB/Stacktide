default:
  image: docker:27
  services:
    - docker:27-dind
variables:
  DOCKER_TLS_CERTDIR: /certs
stages:
  - build
  - release
build:
  stage: build
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  script:
    - docker build --pull -f "Dockerfile" "."
publish:
  stage: release
  rules:
