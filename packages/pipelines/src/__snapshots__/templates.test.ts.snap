"
`;

exports[`the starter templates with secret detection on (SCAN-5) ecs renders with GitLab's template and its job 1`] = `
"# Generated by orch from template ecs@1.0.0. Change the pipeline there: edits here are overwritten.
include:
  - template: Jobs/Secret-Detection.gitlab-ci.yml
workflow:
  rules:
    - if: $ORCH_DEPLOY_ENV
      variables:
        SECRET_DETECTION_DISABLED: "true"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
stages:
  - deploy
deploy:
  stage: deploy
  image: example/aws-docker:1
  services:
    - docker:27-dind
  inherit:
    default: false
  rules:
    - if: $ORCH_DEPLOY_ENV
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
  id_tokens:
    ORCH_OIDC_TOKEN:
      aud: sts.amazonaws.com
  variables:
    DOCKER_TLS_CERTDIR: /certs
    DOCKER_HOST: tcp://docker:2376
    DOCKER_TLS_VERIFY: "1"
    DOCKER_CERT_PATH: /certs/client
    ORCH_DEPLOY_ENV: staging
    ORCH_DEPLOY_SHA: $CI_COMMIT_SHA
    ORCH_DOCKERFILE: Dockerfile
    ORCH_CONTEXT: "."
    ORCH_CLOUD_ACCOUNT: "123456789012"
    ORCH_CLOUD_REGION: eu-west-2
    ORCH_CLOUD_ROLE: staging-web-deploy
    ORCH_CLOUD_CLUSTER: staging-web-service
    ORCH_CLOUD_SERVICE: staging-web-service
    ORCH_CLOUD_REPOSITORY: staging-web-service
  environment:
    name: $ORCH_DEPLOY_ENV
  resource_group: deploy-$ORCH_DEPLOY_ENV
  script:
    - |
      # Deploys one build of the repository to the ECS Fargate service a \`service\` blueprint created (ADR-0025).
      # The forge's runner runs this; the platform never does. It reads only the ORCH_* names validated below, assumes the
      # deploy role with the runner's OIDC token (no access key), and never prints a variable's value.
      set -eu

      fail() { echo "deploy-ecs: $1" >&2; exit 1; }
      # every value reaches a shell, a JSON file or a command line: only a closed set of characters goes on
      safe() { case "$2" in ""|-*|*[!A-Za-z0-9._/@:-]*) fail "$1 is missing or has a character it may not have" ;; esac; }
      is_sha() { case "$1" in ""|*[!0-9a-f]*) return 1 ;; esac; [ "\${#1}" -eq 40 ]; }
      is_slug() { case "$1" in ""|*[!a-z0-9-]*|-*|*-|*--*) return 1 ;; esac; [ "\${#1}" -le 63 ]; }
      is_path() { case "$1" in ""|/*|-*|*..*|*[!A-Za-z0-9._/-]*) return 1 ;; esac; }

      for name in ORCH_DEPLOY_ENV ORCH_DEPLOY_SHA ORCH_CLOUD_ACCOUNT ORCH_CLOUD_REGION ORCH_CLOUD_ROLE \\
        ORCH_CLOUD_CLUSTER ORCH_CLOUD_SERVICE ORCH_CLOUD_REPOSITORY; do
        eval "safe \\$name \\"\\\${$name:-}\\""
      done
      [ -n "\${ORCH_OIDC_TOKEN:-}" ] || fail "ORCH_OIDC_TOKEN is missing: the job must ask the forge for an identity token"
      is_slug "$ORCH_DEPLOY_ENV" || fail "ORCH_DEPLOY_ENV is not an environment slug"
      is_sha "$ORCH_DEPLOY_SHA" || fail "ORCH_DEPLOY_SHA is not a 40-character commit sha"
      case "$ORCH_CLOUD_ACCOUNT" in *[!0-9]*) fail "ORCH_CLOUD_ACCOUNT is not a 12-digit account id" ;; esac
      [ "\${#ORCH_CLOUD_ACCOUNT}" -eq 12 ] || fail "ORCH_CLOUD_ACCOUNT is not a 12-digit account id"
      dockerfile="\${ORCH_DOCKERFILE:-Dockerfile}"
      context="\${ORCH_CONTEXT:-.}"
      is_path "$dockerfile" || fail "ORCH_DOCKERFILE is not a path inside the repository"
      is_path "$context" || fail "ORCH_CONTEXT is not a path inside the repository"
      [ -z "\${ORCH_SERVICE_URL:-}" ] || safe ORCH_SERVICE_URL "$ORCH_SERVICE_URL"

      # the CLI takes the identity from these variables and the token file; any access key the runner holds is dropped first,
      # since a key outranks the token. The token file and the docker login live in a directory removed on exit
      umask 077
      work="$(mktemp -d "\${TMPDIR:-/tmp}/orch-deploy.XXXXXX")"
      trap 'rm -rf "$work"' EXIT
      unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE AWS_CONFIG_FILE AWS_SHARED_CREDENTIALS_FILE
      printf %s "$ORCH_OIDC_TOKEN" > "$work/token"
      export AWS_ROLE_ARN="arn:aws:iam::$ORCH_CLOUD_ACCOUNT:role/$ORCH_CLOUD_ROLE" AWS_WEB_IDENTITY_TOKEN_FILE="$work/token" \\
        AWS_ROLE_SESSION_NAME=orch-deploy AWS_REGION="$ORCH_CLOUD_REGION" AWS_DEFAULT_REGION="$ORCH_CLOUD_REGION" \\
        AWS_EC2_METADATA_DISABLED=true DOCKER_CONFIG="$work/docker"

      aws sts get-caller-identity > /dev/null 2>&1 || fail "could not assume the deploy role with the identity token"
      registry="$ORCH_CLOUD_ACCOUNT.dkr.ecr.$ORCH_CLOUD_REGION.amazonaws.com"
      image="$registry/$ORCH_CLOUD_REPOSITORY:$ORCH_DEPLOY_SHA"

      # the repository is immutable: a tag is pushed once. A rollback, or a re-run, finds the commit's image and deploys it as it is
      if found="$(aws ecr describe-images --repository-name "$ORCH_CLOUD_REPOSITORY" --image-ids "imageTag=$ORCH_DEPLOY_SHA" \\
        --query 'imageDetails[0].imageDigest' --output text 2>&1)"; then
        echo "deploy-ecs: the image for $ORCH_DEPLOY_SHA is already in $ORCH_CLOUD_REPOSITORY"
      else
        case "$found" in *ImageNotFoundException*) ;; *) fail "could not read the repository $ORCH_CLOUD_REPOSITORY" ;; esac
        aws ecr get-login-password | docker login --username AWS --password-stdin "$registry" > /dev/null 2>&1 \\
          || fail "could not sign in to $registry"
        docker build --pull -f "$dockerfile" -t "$image" "$context"
        docker push "$image"
      fi

      # a new revision of the service's task definition, the same but for its one image. The service is Terraform's, and it
      # ignores changes to its task definition (\`ignore_changes\`), so this revision survives the next apply
      # shortcut: only the fields the platform's own module sets are copied; a hand-added field (placement, runtime platform) is dropped, so a volume stops the deploy and the rest is not checked
      current="$(aws ecs describe-services --cluster "$ORCH_CLOUD_CLUSTER" --services "$ORCH_CLOUD_SERVICE" \\
        --query 'services[0].taskDefinition' --output text)"
      safe "the service's task definition" "$current"
      [ "$(aws ecs describe-task-definition --task-definition "$current" --query 'length(taskDefinition.volumes)' --output text)" = 0 ] \\
        || fail "the task definition has volumes, which this script does not copy"
      aws ecs describe-task-definition --task-definition "$current" --output json \\
        --query 'taskDefinition.{family:family,taskRoleArn:taskRoleArn,executionRoleArn:executionRoleArn,networkMode:networkMode,requiresCompatibilities:requiresCompatibilities,cpu:cpu,memory:memory,containerDefinitions:containerDefinitions}' \\
        > "$work/definition.json"
      [ "$(grep -c '"image":' "$work/definition.json")" = 1 ] || fail "the task definition does not have exactly one container"
      sed "s|\\"image\\": *\\"[^\\"]*\\"|\\"image\\": \\"$image\\"|" "$work/definition.json" > "$work/next.json"
      revision="$(aws ecs register-task-definition --cli-input-json "file://$work/next.json" \\
        --query 'taskDefinition.taskDefinitionArn' --output text)"
      safe "the new task definition" "$revision"
      aws ecs update-service --cluster "$ORCH_CLOUD_CLUSTER" --service "$ORCH_CLOUD_SERVICE" --task-definition "$revision" > /dev/null
      aws ecs wait services-stable --cluster "$ORCH_CLOUD_CLUSTER" --services "$ORCH_CLOUD_SERVICE"
      echo "deploy-ecs: $ORCH_CLOUD_SERVICE is running $ORCH_DEPLOY_SHA in $ORCH_DEPLOY_ENV\${ORCH_SERVICE_URL:+ at $ORCH_SERVICE_URL}"
secret_detection:
  stage: deploy
  inherit:
    default: false
"
`;

exports[`the starter templates with secret detection on (SCAN-5) node-app renders with GitLab's template and its job 1`] = `
"# Generated by orch from template node-app@1.0.0. Change the pipeline there: edits here are overwritten.
include:
  - template: Jobs/Secret-Detection.gitlab-ci.yml
workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
default:
  image: node:22
  cache:
    key:
      files:
        - package-lock.json
    paths:
      - .npm/
  before_script:
    - npm ci --cache .npm --prefer-offline
stages:
  - check
  - build
typecheck:
  stage: check
  script:
    - npm run typecheck
lint:
  stage: check
  script:
    - npm run lint
test:
  stage: check
  script:
    - npm run test
build:
  stage: build
  script:
    - npm run build
  artifacts:
    paths:
      - dist/
    expire_in: 1 week
secret_detection:
  stage: check
  inherit:
    default: false
"
`;
