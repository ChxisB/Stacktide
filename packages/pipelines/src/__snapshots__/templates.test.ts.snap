// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`the starter templates bun-app renders with its defaults 1`] = `
"# Generated by orch from template bun-app@1.0.0. Change the pipeline there: edits here are overwritten.
workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
default:
  image: oven/bun:1
  cache:
    key:
      files:
        - bun.lock
    paths:
      - node_modules/
  before_script:
    - bun install --frozen-lockfile
stages:
  - check
  - build
typecheck:
  stage: check
  script:
    - bun run typecheck
lint:
  stage: check
  script:
    - bun run lint
test:
  stage: check
  script:
    - bun run test
build:
  stage: build
  script:
    - bun run build
  artifacts:
    paths:
      - dist/
    expire_in: 1 week
"
`;

exports[`the starter templates docker-image renders with its defaults 1`] = `
"# Generated by orch from template docker-image@1.0.0. Change the pipeline there: edits here are overwritten.
workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
default:
  image: docker:27
  services:
    - docker:27-dind
variables:
  DOCKER_TLS_CERTDIR: /certs
stages:
  - build
  - release
build:
  stage: build
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  script:
    - docker build --pull -f "Dockerfile" "."
publish:
  stage: release
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
  before_script:
    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"
  script:
    - docker build --pull -f "Dockerfile" -t "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA" -t "$CI_REGISTRY_IMAGE:latest" "."
    - docker push "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA"
    - docker push "$CI_REGISTRY_IMAGE:latest"
"
`;

exports[`the starter templates node-app renders with its defaults 1`] = `
"# Generated by orch from template node-app@1.0.0. Change the pipeline there: edits here are overwritten.
workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
default:
  image: node:22
  cache:
    key:
      files:
        - package-lock.json
    paths:
      - .npm/
  before_script:
    - npm ci --cache .npm --prefer-offline
stages:
  - check
  - build
typecheck:
  stage: check
  script:
    - npm run typecheck
lint:
  stage: check
  script:
    - npm run lint
test:
  stage: check
  script:
    - npm run test
build:
  stage: build
  script:
    - npm run build
  artifacts:
    paths:
      - dist/
    expire_in: 1 week
"
`;

