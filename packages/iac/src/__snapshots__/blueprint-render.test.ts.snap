exports[`renderBlueprint service gcp on gitlab: the stack's own files 1`] = `
"# infra/staging/main-service/README.md
# staging-main-service

Written by the platform from a blueprint: a \`service\` on \`gcp\`, profile \`medium\`.

- \`stack.yml\` marks this directory as a stack: its name, the Terraform version and where the state lives.
- \`main.tf\` sets the provider, calls the module with the values the blueprint allows and passes on the module's public outputs (its console link, and a service's address). It holds no secret.
- The module is a copy at \`../../_blueprints/gcp/service-v1\`, shared by every \`service\` on \`gcp\` in this repository. It is never edited in place: a newer version is a new directory and a new proposal.

Uses: \`bucket:files\`, \`network:main\`, \`postgres:main\`.

Change this resource by proposing a change through the platform. A hand edit of these files is overwritten by the next one.

# infra/staging/main-service/main.tf
terraform {
  backend "http" {}
}

provider "google" {
  project = "my-proj-123"
  region  = "us-central1"
}

module "this" {
  source        = "../../_blueprints/gcp/service-v1"
  environment   = "staging"
  name          = "main"
  project       = "my-proj-123"
  region        = "us-central1"
  image         = "europe-docker.pkg.dev/my-proj-123/staging/app:1.2.3"
  port          = 3000
  public        = true
  cpu           = "1"
  memory        = "1Gi"
  min_instances = 1
  max_instances = 10
  network       = "main"
  databases     = ["main"]
  buckets       = ["files"]
}

output "url" {
  value = module.this.url
}

output "console_url" {
  value = module.this.console_url
}

# infra/staging/main-service/stack.yml
# Written by the platform from a blueprint (service on gcp); see README.md.
name: staging-main-service
tool: terraform
version: 1.5.7
state: gitlab
depends_on:
  - staging-files-bucket
  - staging-main-network
  - staging-main-postgres
watch:
  - infra/_blueprints/gcp/service-v1/**
"
`;

