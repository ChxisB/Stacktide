// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`a plan pipeline snapshot 1`] = `
"# Generated by orch: a child pipeline for plan of 4 stacks. Do not edit.
stages:
  - wave-0
  - wave-1
  - wave-2
  - summary
plan:net:
  stage: wave-0
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-net
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs: []
  interruptible: true
  artifacts:
    paths:
      - stacks/net/plan.tfplan
      - stacks/net/plan.json
    expire_in: 1 week
    access: developer
  script:
    - cd stacks/net
    - terraform init -input=false
    - terraform plan -input=false -lock-timeout=5m -out=plan.tfplan
    - terraform show -json plan.tfplan > plan.json
summary:net:
  stage: summary
  image:
    name: registry.example.com/orch/ci-helper:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:net
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack net '(.resource_changes // []) | map(select(.change.actions != [\\"no-op\\"] and .change.actions != [\\"read\\"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index(\\"create\\"))) | length), change: ($c | map(select(.change.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.change.actions | index(\\"delete\\"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' stacks/net/plan.json > summary.json"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
plan:db:
  stage: wave-1
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-db
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs:
    - job: plan:net
      artifacts: false
  interruptible: true
  artifacts:
    paths:
      - stacks/db/plan.tfplan
      - stacks/db/plan.json
    expire_in: 1 week
    access: developer
  script:
    - cd stacks/db
    - terraform init -input=false
    - terraform plan -input=false -lock-timeout=5m -out=plan.tfplan
    - terraform show -json plan.tfplan > plan.json
summary:db:
  stage: summary
  image:
    name: registry.example.com/orch/ci-helper:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:db
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack db '(.resource_changes // []) | map(select(.change.actions != [\\"no-op\\"] and .change.actions != [\\"read\\"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index(\\"create\\"))) | length), change: ($c | map(select(.change.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.change.actions | index(\\"delete\\"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' stacks/db/plan.json > summary.json"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
plan:queue:
  stage: wave-1
  image:
    name: ghcr.io/opentofu/opentofu:1.8.2
    entrypoint:
      - ""
  resource_group: stack-queue
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/queue
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/queue/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/queue/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs:
    - job: plan:net
      artifacts: false
  interruptible: true
  artifacts:
    paths:
      - stacks/queue/plan.tfplan
      - stacks/queue/plan.json
    expire_in: 1 week
    access: developer
  script:
    - cd stacks/queue
    - tofu init -input=false
    - tofu plan -input=false -lock-timeout=5m -out=plan.tfplan
    - tofu show -json plan.tfplan > plan.json
summary:queue:
  stage: summary
  image:
    name: registry.example.com/orch/ci-helper:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:queue
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack queue '(.resource_changes // []) | map(select(.change.actions != [\\"no-op\\"] and .change.actions != [\\"read\\"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index(\\"create\\"))) | length), change: ($c | map(select(.change.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.change.actions | index(\\"delete\\"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' stacks/queue/plan.json > summary.json"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
plan:app:
  stage: wave-2
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-app
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs:
    - job: plan:db
      artifacts: false
  interruptible: true
  artifacts:
    paths:
      - stacks/app/plan.tfplan
      - stacks/app/plan.json
    expire_in: 1 week
    access: developer
  script:
    - cd stacks/app
    - terraform init -input=false
    - terraform plan -input=false -lock-timeout=5m -out=plan.tfplan
    - terraform show -json plan.tfplan > plan.json
summary:app:
  stage: summary
  image:
    name: registry.example.com/orch/ci-helper:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:app
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack app '(.resource_changes // []) | map(select(.change.actions != [\\"no-op\\"] and .change.actions != [\\"read\\"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index(\\"create\\"))) | length), change: ($c | map(select(.change.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.change.actions | index(\\"delete\\"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' stacks/app/plan.json > summary.json"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
"
`;

exports[`an apply pipeline snapshot 1`] = `
"# Generated by orch: a child pipeline for apply of 4 stacks. Do not edit.
stages:
  - wave-0
  - wave-1
  - wave-2
apply:net:
  stage: wave-0
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-net
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs: []
  script:
    - cd stacks/net
    - 'wget -q --header "JOB-TOKEN: $CI_JOB_TOKEN" -O plan.tfplan "$CI_API_V4_URL/projects/$CI_PROJECT_ID/jobs/101/artifacts/stacks/net/plan.tfplan"'
    - terraform init -input=false
    - terraform apply -input=false -lock-timeout=5m plan.tfplan
apply:db:
  stage: wave-1
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-db
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs:
    - job: apply:net
      artifacts: false
  script:
    - cd stacks/db
    - 'wget -q --header "JOB-TOKEN: $CI_JOB_TOKEN" -O plan.tfplan "$CI_API_V4_URL/projects/$CI_PROJECT_ID/jobs/103/artifacts/stacks/db/plan.tfplan"'
    - terraform init -input=false
    - terraform apply -input=false -lock-timeout=5m plan.tfplan
apply:queue:
  stage: wave-1
  image:
    name: ghcr.io/opentofu/opentofu:1.8.2
    entrypoint:
      - ""
  resource_group: stack-queue
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/queue
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/queue/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/queue/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs:
    - job: apply:net
      artifacts: false
  script:
    - cd stacks/queue
    - 'wget -q --header "JOB-TOKEN: $CI_JOB_TOKEN" -O plan.tfplan "$CI_API_V4_URL/projects/$CI_PROJECT_ID/jobs/102/artifacts/stacks/queue/plan.tfplan"'
    - tofu init -input=false
    - tofu apply -input=false -lock-timeout=5m plan.tfplan
apply:app:
  stage: wave-2
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-app
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs:
    - job: apply:db
      artifacts: false
  script:
    - cd stacks/app
    - 'wget -q --header "JOB-TOKEN: $CI_JOB_TOKEN" -O plan.tfplan "$CI_API_V4_URL/projects/$CI_PROJECT_ID/jobs/104/artifacts/stacks/app/plan.tfplan"'
    - terraform init -input=false
    - terraform apply -input=false -lock-timeout=5m plan.tfplan
"
`;

exports[`policy in a plan pipeline snapshot 1`] = `
"# Generated by orch: a child pipeline for plan of 3 stacks. Do not edit.
stages:
  - wave-0
  - wave-1
  - wave-2
  - summary
plan:net:
  stage: wave-0
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-net
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs: []
  interruptible: true
  artifacts:
    paths:
      - stacks/net/plan.tfplan
      - stacks/net/plan.json
    expire_in: 1 week
    access: developer
  script:
    - cd stacks/net
    - terraform init -input=false
    - terraform plan -input=false -lock-timeout=5m -out=plan.tfplan
    - terraform show -json plan.tfplan > plan.json
summary:net:
  stage: summary
  image:
    name: registry.example.com/orch/ci-helper:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:net
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack net '(.resource_changes // []) | map(select(.change.actions != [\\"no-op\\"] and .change.actions != [\\"read\\"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index(\\"create\\"))) | length), change: ($c | map(select(.change.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.change.actions | index(\\"delete\\"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' stacks/net/plan.json > summary.json"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
plan:db:
  stage: wave-1
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-db
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs:
    - job: plan:net
      artifacts: false
  interruptible: true
  artifacts:
    paths:
      - stacks/db/plan.tfplan
      - stacks/db/plan.json
    expire_in: 1 week
    access: developer
  script:
    - cd stacks/db
    - terraform init -input=false
    - terraform plan -input=false -lock-timeout=5m -out=plan.tfplan
    - terraform show -json plan.tfplan > plan.json
summary:db:
  stage: summary
  image:
    name: registry.example.com/orch/ci-policy:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:db
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack db '(.resource_changes // []) | map(select(.change.actions != [\\"no-op\\"] and .change.actions != [\\"read\\"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index(\\"create\\"))) | length), change: ($c | map(select(.change.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.change.actions | index(\\"delete\\"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' stacks/db/plan.json > summary.json"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
    - "curl --fail --silent --show-error --location --header \\"JOB-TOKEN: $CI_JOB_TOKEN\\" --output policy-0.tgz \\"$CI_API_V4_URL/projects/platform%2Fpolicies/repository/archive.tar.gz?sha=v1.2.0\\" && mkdir -p policy/0 && tar -xzf policy-0.tgz -C policy/0 --strip-components=1 && curl --fail --silent --show-error --location --header \\"JOB-TOKEN: $CI_JOB_TOKEN\\" --output policy-1.tgz \\"$CI_API_V4_URL/projects/platform%2Fpci/repository/archive.tar.gz?sha=main\\" && mkdir -p policy/1 && tar -xzf policy-1.tgz -C policy/1 --strip-components=1 && { conftest test --no-color --output json --all-namespaces --policy policy/0/terraform --policy policy/1 stacks/db/plan.json > policy.json || :; } && jq -e -c -s --arg stack db '.[0] | if type == \\"array\\" and length > 0 then {stack: $stack, evaluated: true, denied: ([.[].failures[]? | (.metadata.query // \\"unnamed\\") | tostring | gsub(\\"[^A-Za-z0-9_.:-]\\"; \\"_\\") | .[:200]] | unique | .[:50]), warned: ([.[].warnings[]? | (.metadata.query // \\"unnamed\\") | tostring | gsub(\\"[^A-Za-z0-9_.:-]\\"; \\"_\\") | .[:200]] | unique | .[:50])} else error(\\"not a policy result\\") end' policy.json > policy-verdict.json || printf '{\\"stack\\":\\"db\\",\\"evaluated\\":false}' > policy-verdict.json"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @policy-verdict.json "$ORCH_API_URL/runs/0b9e5bd2/policy-verdict"'
plan:app:
  stage: wave-2
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-app
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs:
    - job: plan:db
      artifacts: false
  interruptible: true
  artifacts:
    paths:
      - stacks/app/plan.tfplan
      - stacks/app/plan.json
    expire_in: 1 week
    access: developer
  script:
    - cd stacks/app
    - terraform init -input=false
    - terraform plan -input=false -lock-timeout=5m -out=plan.tfplan
    - terraform show -json plan.tfplan > plan.json
summary:app:
  stage: summary
  image:
    name: registry.example.com/orch/ci-policy:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:app
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack app '(.resource_changes // []) | map(select(.change.actions != [\\"no-op\\"] and .change.actions != [\\"read\\"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index(\\"create\\"))) | length), change: ($c | map(select(.change.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.change.actions | index(\\"delete\\"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' stacks/app/plan.json > summary.json"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
    - "curl --fail --silent --show-error --location --header \\"JOB-TOKEN: $CI_JOB_TOKEN\\" --output policy-0.tgz \\"$CI_API_V4_URL/projects/platform%2Fpolicies/repository/archive.tar.gz?sha=v1.2.0\\" && mkdir -p policy/0 && tar -xzf policy-0.tgz -C policy/0 --strip-components=1 && { conftest test --no-color --output json --all-namespaces --policy policy/0/terraform stacks/app/plan.json > policy.json || :; } && jq -e -c -s --arg stack app '.[0] | if type == \\"array\\" and length > 0 then {stack: $stack, evaluated: true, denied: ([.[].failures[]? | (.metadata.query // \\"unnamed\\") | tostring | gsub(\\"[^A-Za-z0-9_.:-]\\"; \\"_\\") | .[:200]] | unique | .[:50]), warned: ([.[].warnings[]? | (.metadata.query // \\"unnamed\\") | tostring | gsub(\\"[^A-Za-z0-9_.:-]\\"; \\"_\\") | .[:200]] | unique | .[:50])} else error(\\"not a policy result\\") end' policy.json > policy-verdict.json || printf '{\\"stack\\":\\"app\\",\\"evaluated\\":false}' > policy-verdict.json"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @policy-verdict.json "$ORCH_API_URL/runs/0b9e5bd2/policy-verdict"'
"
`;

exports[`cost in a plan pipeline (COST-4) snapshot 1`] = `
"# Generated by orch: a child pipeline for plan of 3 stacks. Do not edit.
stages:
  - wave-0
  - wave-1
  - wave-2
  - estimate
  - summary
plan:net:
  stage: wave-0
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-net
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs: []
  interruptible: true
  artifacts:
    paths:
      - stacks/net/plan.tfplan
      - stacks/net/plan.json
    expire_in: 1 week
    access: developer
  script:
    - cd stacks/net
    - terraform init -input=false
    - terraform plan -input=false -lock-timeout=5m -out=plan.tfplan
    - terraform show -json plan.tfplan > plan.json
summary:net:
  stage: summary
  image:
    name: registry.example.com/orch/ci-helper:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:net
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack net '(.resource_changes // []) | map(select(.change.actions != [\\"no-op\\"] and .change.actions != [\\"read\\"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index(\\"create\\"))) | length), change: ($c | map(select(.change.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.change.actions | index(\\"delete\\"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' stacks/net/plan.json > summary.json"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
plan:db:
  stage: wave-1
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-db
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/db/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs:
    - job: plan:net
      artifacts: false
  interruptible: true
  artifacts:
    paths:
      - stacks/db/plan.tfplan
      - stacks/db/plan.json
    expire_in: 1 week
    access: developer
  script:
    - cd stacks/db
    - terraform init -input=false
    - terraform plan -input=false -lock-timeout=5m -out=plan.tfplan
    - terraform show -json plan.tfplan > plan.json
estimate:db:
  stage: estimate
  image:
    name: registry.example.com/orch/ci-cost:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:db
      artifacts: true
  allow_failure: true
  interruptible: true
  artifacts:
    paths:
      - cost.json
    expire_in: 1 week
  script:
    - "{ [ -n \\"$INFRACOST_API_KEY\\" ] && infracost diff --path stacks/db/plan.json --format json > infracost.json && jq -e -c --arg tool infracost 'def amount: (if type == \\"string\\" then tonumber else . end) | select(type == \\"number\\" and . >= -1e12 and . <= 1e12); (.currency | select(type == \\"string\\" and test(\\"^[A-Z]{3}$\\"))) as $currency | (.totalMonthlyCost | amount | select(. >= 0)) as $total | (.diffTotalMonthlyCost | amount) as $delta | {monthlyDelta: $delta, monthlyTotal: $total, currency: $currency, tool: $tool}' infracost.json > cost.json; } || rm -f cost.json"
summary:db:
  stage: summary
  image:
    name: registry.example.com/orch/ci-helper:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:db
      artifacts: true
    - job: estimate:db
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack db '(.resource_changes // []) | map(select(.change.actions != [\\"no-op\\"] and .change.actions != [\\"read\\"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index(\\"create\\"))) | length), change: ($c | map(select(.change.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.change.actions | index(\\"delete\\"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' stacks/db/plan.json > summary.json"
    - "if [ -s cost.json ] && jq -c --slurpfile cost cost.json '. + {cost: $cost[0]}' summary.json > summary.merged; then mv summary.merged summary.json; fi"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
plan:app:
  stage: wave-2
  image:
    name: hashicorp/terraform:1.9.8
    entrypoint:
      - ""
  resource_group: stack-app
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/app/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs:
    - job: plan:db
      artifacts: false
  interruptible: true
  artifacts:
    paths:
      - stacks/app/plan.tfplan
      - stacks/app/plan.json
    expire_in: 1 week
    access: developer
  script:
    - cd stacks/app
    - terraform init -input=false
    - terraform plan -input=false -lock-timeout=5m -out=plan.tfplan
    - terraform show -json plan.tfplan > plan.json
estimate:app:
  stage: estimate
  image:
    name: registry.example.com/orch/ci-cost:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:app
      artifacts: true
  allow_failure: true
  interruptible: true
  artifacts:
    paths:
      - cost.json
    expire_in: 1 week
  script:
    - "{ [ -n \\"$INFRACOST_API_KEY\\" ] && infracost diff --path stacks/app/plan.json --format json > infracost.json && jq -e -c --arg tool infracost 'def amount: (if type == \\"string\\" then tonumber else . end) | select(type == \\"number\\" and . >= -1e12 and . <= 1e12); (.currency | select(type == \\"string\\" and test(\\"^[A-Z]{3}$\\"))) as $currency | (.totalMonthlyCost | amount | select(. >= 0)) as $total | (.diffTotalMonthlyCost | amount) as $delta | {monthlyDelta: $delta, monthlyTotal: $total, currency: $currency, tool: $tool}' infracost.json > cost.json; } || rm -f cost.json"
summary:app:
  stage: summary
  image:
    name: registry.example.com/orch/ci-helper:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:app
      artifacts: true
    - job: estimate:app
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack app '(.resource_changes // []) | map(select(.change.actions != [\\"no-op\\"] and .change.actions != [\\"read\\"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index(\\"create\\"))) | length), change: ($c | map(select(.change.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.change.actions | index(\\"delete\\"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' stacks/app/plan.json > summary.json"
    - "if [ -s cost.json ] && jq -c --slurpfile cost cost.json '. + {cost: $cost[0]}' summary.json > summary.merged; then mv summary.merged summary.json; fi"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
"
`;

