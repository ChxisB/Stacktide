    - cd stacks/plain
    - terraform init -input=false
    - terraform plan -input=false -lock-timeout=5m -out=plan.tfplan
    - terraform show -json plan.tfplan > plan.json
summary:plain:
  stage: summary
  image:
    name: registry.example.com/orch/ci-helper:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:plain
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack plain '(.resource_changes // []) | map(select(.change.actions != [\\"no-op\\"] and .change.actions != [\\"read\\"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index(\\"create\\"))) | length), change: ($c | map(select(.change.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.change.actions | index(\\"delete\\"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' stacks/plain/plan.json > summary.json"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
"
`;

exports[`a stack whose state is on the platform (STATE-5) snapshot: a plan and an apply with one stack of each kind 2`] = `
"# Generated by orch: a child pipeline for apply of 3 stacks. Do not edit.
stages:
  - wave-0
apply:db:
  stage: wave-0
  image:
    name: registry.example.com/platform/terraform-orch:1.9.8
    entrypoint:
      - ""
  resource_group: stack-db
  variables:
    ORCH_API_URL: https://orch.example.com
  needs: []
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  timeout: 1h
  script:
    - cd stacks/db
    - login="$(orch ci login --state)"
    - eval "$login"
    - export TF_HTTP_ADDRESS="$ORCH_API_URL/organizations/$ORCH_ORG/projects/$ORCH_PROJECT/state/db" TF_HTTP_USERNAME=ci TF_HTTP_PASSWORD="$ORCH_STATE_TOKEN"
    - export TF_HTTP_LOCK_ADDRESS="$TF_HTTP_ADDRESS/lock" TF_HTTP_LOCK_METHOD=POST TF_HTTP_UNLOCK_ADDRESS="$TF_HTTP_ADDRESS/lock" TF_HTTP_UNLOCK_METHOD=DELETE
    - 'wget -q --header "JOB-TOKEN: $CI_JOB_TOKEN" -O plan.tfplan "$CI_API_V4_URL/projects/$CI_PROJECT_ID/jobs/1/artifacts/stacks/db/plan.tfplan"'
    - terraform init -input=false
    - terraform apply -input=false -lock-timeout=5m plan.tfplan
apply:net:
  stage: wave-0
  image:
    name: registry.example.com/platform/terraform-orch:1.9.8
    entrypoint:
      - ""
  resource_group: stack-net
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/net/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs: []
  script:
    - cd stacks/net
    - 'wget -q --header "JOB-TOKEN: $CI_JOB_TOKEN" -O plan.tfplan "$CI_API_V4_URL/projects/$CI_PROJECT_ID/jobs/2/artifacts/stacks/net/plan.tfplan"'
    - terraform init -input=false
    - terraform apply -input=false -lock-timeout=5m plan.tfplan
apply:plain:
  stage: wave-0
  image:
    name: registry.example.com/platform/terraform-orch:1.9.8
    entrypoint:
      - ""
  resource_group: stack-plain
  variables:
    TF_HTTP_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/plain
    TF_HTTP_LOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/plain/lock
    TF_HTTP_LOCK_METHOD: POST
    TF_HTTP_UNLOCK_ADDRESS: $CI_API_V4_URL/projects/$CI_PROJECT_ID/terraform/state/plain/lock
    TF_HTTP_UNLOCK_METHOD: DELETE
    TF_HTTP_USERNAME: gitlab-ci-token
    TF_HTTP_PASSWORD: $CI_JOB_TOKEN
    TF_HTTP_RETRY_WAIT_MIN: "5"
  needs: []
  script:
    - cd stacks/plain
    - 'wget -q --header "JOB-TOKEN: $CI_JOB_TOKEN" -O plan.tfplan "$CI_API_V4_URL/projects/$CI_PROJECT_ID/jobs/3/artifacts/stacks/plain/plan.tfplan"'
    - terraform init -input=false
    - terraform apply -input=false -lock-timeout=5m plan.tfplan
"
`;
