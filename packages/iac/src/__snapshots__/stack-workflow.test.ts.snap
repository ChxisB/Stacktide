// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`the file is where the onboarding puts it, and is the same for every run: a snapshot 1`] = `
"# Generated by orch: the workflow that runs the stacks of a run. Do not edit: it is the same for every run and reads what to run from the platform.
name: orch stacks
run-name: orch \${{ inputs.run_id }} \${{ inputs.action }}
"on":
  workflow_dispatch:
    inputs:
      run_id:
        description: The id of the run on the platform
        required: true
        type: string
      action:
        description: Whether the run plans its stacks or applies the plan that was judged
        required: false
        type: choice
        options:
          - plan
          - apply
        default: plan
permissions:
  contents: read
  id-token: write
jobs:
  fetch:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    outputs:
      level0: \${{ steps.plan.outputs.level0 }}
      level1: \${{ steps.plan.outputs.level1 }}
      level2: \${{ steps.plan.outputs.level2 }}
      level3: \${{ steps.plan.outputs.level3 }}
      level4: \${{ steps.plan.outputs.level4 }}
      level5: \${{ steps.plan.outputs.level5 }}
      action: \${{ steps.plan.outputs.action }}
      sha: \${{ steps.plan.outputs.sha }}
    steps:
      - id: plan
        env:
          RUN_ID: \${{ inputs.run_id }}
          ACTION: \${{ inputs.action }}
          ORCH_API_URL: https://orch.example.com
          ORCH_AUDIENCE: orch.example.com
        run: |-
          set -eo pipefail
          uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
          [[ "$RUN_ID" =~ $uuid ]] || { echo "run_id is not the id of a run" >&2; exit 1; }
          [ "$ACTION" = plan ] || [ "$ACTION" = apply ] || { echo "action is neither plan nor apply" >&2; exit 1; }
          [ -n "$ACTIONS_ID_TOKEN_REQUEST_URL" ] || { echo "the job has no identity token: the workflow needs the permission id-token: write" >&2; exit 1; }
          mint() {
            curl --fail --silent --show-error --header "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$(jq -rn --arg a "$1" '$a|@uri')" | jq -er .value
          }
          id_token="$(mint "$ORCH_AUDIENCE")"
          echo "::add-mask::$id_token"
          exchange="$(jq -n --arg t "$id_token" '{id_token: $t}' | curl --fail --silent --show-error --request POST --header "Content-Type: application/json" --data @- "$ORCH_API_URL/auth/ci/exchange")"
          token="$(jq -er .token <<<"$exchange")"
          echo "::add-mask::$token"
          org="$(jq -er .organizationId <<<"$exchange")"
          project="$(jq -er .projectId <<<"$exchange")"
          [[ "$org" =~ $uuid && "$project" =~ $uuid ]] || { echo "the platform answered with a project that is not an id" >&2; exit 1; }
          plan="$(curl --fail --silent --show-error --header "Authorization: Bearer $token" "$ORCH_API_URL/organizations/$org/projects/$project/runs/$RUN_ID/plan?action=$ACTION")"
          jq -e --arg a "$ACTION" '.action == $a' <<<"$plan" > /dev/null || { echo "the platform answered with the plan of another action" >&2; exit 1; }
          sha=""
          if [ "$ACTION" = apply ]; then
            sha="$(jq -r '.sha // ""' <<<"$plan")"
            shaRe='^[0-9a-f]{40}$'
            [[ "$sha" =~ $shaRe ]] || { echo "the plan of an apply names no commit to apply" >&2; exit 1; }
          fi
          depth="$(jq -e '.levels | length' <<<"$plan")"
          [ "$depth" -le 6 ] || { echo "the run's stacks are in $depth levels; this workflow has room for 6" >&2; exit 1; }
          { for i in 0 1 2 3 4 5; do echo "level$i=$(jq -c --argjson i "$i" '.levels[$i] // []' <<<"$plan")"; done; echo "action=$ACTION"; echo "sha=$sha"; } >> "$GITHUB_OUTPUT"
  level-0:
    name: plan:\${{ matrix.stack.name }}
    needs: fetch
    if: needs.fetch.outputs.action == 'plan' && needs.fetch.outputs.level0 != '[]'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        stack: \${{ fromJSON(needs.fetch.outputs.level0) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - env:
          STACK: \${{ toJSON(matrix.stack) }}
        run: |-
          set -eo pipefail
          [ -n "$ACTIONS_ID_TOKEN_REQUEST_URL" ] || { echo "the job has no identity token: the workflow needs the permission id-token: write" >&2; exit 1; }
          mint() {
            curl --fail --silent --show-error --header "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$(jq -rn --arg a "$1" '$a|@uri')" | jq -er .value
          }
          for kind in plan summary; do
            job="$(jq -c --arg k "$kind" '.jobs[$k] // empty' <<<"$STACK")"
            [ -n "$job" ] || continue
            (
              set --
              envfile="$(mktemp)"
              jq -r '.env | to_entries[] | if (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | test("[\\r\\n]") | not) then "\\(.key)=\\(.value)" else error("a variable that cannot be passed") end' <<<"$job" > "$envfile"
              tokens="$(jq -r '.idTokens | to_entries[] | [.key, .value] | @tsv' <<<"$job")"
              while IFS=$'\\t' read -r var aud; do
                [ -n "$var" ] || continue
                value="$(mint "$aud")"
                echo "::add-mask::$value"
                export "$var=$value"
                set -- "$@" --env "$var"
              done <<<"$tokens"
              commands="$(jq -r '.commands | join("\\n")' <<<"$job")"
              image="$(jq -r .image <<<"$job")"
              docker run --rm --volume "$PWD:/work" --workdir /work --env-file "$envfile" "$@" --entrypoint sh "$image" -e -c "$commands"
              rm -f "$envfile"
            )
          done
  level-1:
    name: plan:\${{ matrix.stack.name }}
    needs:
      - fetch
      - level-0
    if: needs.fetch.outputs.action == 'plan' && needs.fetch.outputs.level1 != '[]'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        stack: \${{ fromJSON(needs.fetch.outputs.level1) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - env:
          STACK: \${{ toJSON(matrix.stack) }}
        run: |-
          set -eo pipefail
          [ -n "$ACTIONS_ID_TOKEN_REQUEST_URL" ] || { echo "the job has no identity token: the workflow needs the permission id-token: write" >&2; exit 1; }
          mint() {
            curl --fail --silent --show-error --header "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$(jq -rn --arg a "$1" '$a|@uri')" | jq -er .value
          }
          for kind in plan summary; do
            job="$(jq -c --arg k "$kind" '.jobs[$k] // empty' <<<"$STACK")"
            [ -n "$job" ] || continue
            (
              set --
              envfile="$(mktemp)"
              jq -r '.env | to_entries[] | if (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | test("[\\r\\n]") | not) then "\\(.key)=\\(.value)" else error("a variable that cannot be passed") end' <<<"$job" > "$envfile"
              tokens="$(jq -r '.idTokens | to_entries[] | [.key, .value] | @tsv' <<<"$job")"
              while IFS=$'\\t' read -r var aud; do
                [ -n "$var" ] || continue
                value="$(mint "$aud")"
                echo "::add-mask::$value"
                export "$var=$value"
                set -- "$@" --env "$var"
              done <<<"$tokens"
              commands="$(jq -r '.commands | join("\\n")' <<<"$job")"
              image="$(jq -r .image <<<"$job")"
              docker run --rm --volume "$PWD:/work" --workdir /work --env-file "$envfile" "$@" --entrypoint sh "$image" -e -c "$commands"
              rm -f "$envfile"
            )
          done
  level-2:
    name: plan:\${{ matrix.stack.name }}
    needs:
      - fetch
      - level-1
    if: needs.fetch.outputs.action == 'plan' && needs.fetch.outputs.level2 != '[]'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        stack: \${{ fromJSON(needs.fetch.outputs.level2) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - env:
          STACK: \${{ toJSON(matrix.stack) }}
        run: |-
          set -eo pipefail
          [ -n "$ACTIONS_ID_TOKEN_REQUEST_URL" ] || { echo "the job has no identity token: the workflow needs the permission id-token: write" >&2; exit 1; }
          mint() {
            curl --fail --silent --show-error --header "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$(jq -rn --arg a "$1" '$a|@uri')" | jq -er .value
          }
          for kind in plan summary; do
            job="$(jq -c --arg k "$kind" '.jobs[$k] // empty' <<<"$STACK")"
            [ -n "$job" ] || continue
            (
              set --
              envfile="$(mktemp)"
              jq -r '.env | to_entries[] | if (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | test("[\\r\\n]") | not) then "\\(.key)=\\(.value)" else error("a variable that cannot be passed") end' <<<"$job" > "$envfile"
              tokens="$(jq -r '.idTokens | to_entries[] | [.key, .value] | @tsv' <<<"$job")"
              while IFS=$'\\t' read -r var aud; do
                [ -n "$var" ] || continue
                value="$(mint "$aud")"
                echo "::add-mask::$value"
                export "$var=$value"
                set -- "$@" --env "$var"
              done <<<"$tokens"
              commands="$(jq -r '.commands | join("\\n")' <<<"$job")"
              image="$(jq -r .image <<<"$job")"
              docker run --rm --volume "$PWD:/work" --workdir /work --env-file "$envfile" "$@" --entrypoint sh "$image" -e -c "$commands"
              rm -f "$envfile"
            )
          done
  level-3:
    name: plan:\${{ matrix.stack.name }}
    needs:
      - fetch
      - level-2
    if: needs.fetch.outputs.action == 'plan' && needs.fetch.outputs.level3 != '[]'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        stack: \${{ fromJSON(needs.fetch.outputs.level3) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - env:
          STACK: \${{ toJSON(matrix.stack) }}
        run: |-
          set -eo pipefail
          [ -n "$ACTIONS_ID_TOKEN_REQUEST_URL" ] || { echo "the job has no identity token: the workflow needs the permission id-token: write" >&2; exit 1; }
          mint() {
            curl --fail --silent --show-error --header "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$(jq -rn --arg a "$1" '$a|@uri')" | jq -er .value
          }
          for kind in plan summary; do
            job="$(jq -c --arg k "$kind" '.jobs[$k] // empty' <<<"$STACK")"
            [ -n "$job" ] || continue
            (
              set --
              envfile="$(mktemp)"
              jq -r '.env | to_entries[] | if (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | test("[\\r\\n]") | not) then "\\(.key)=\\(.value)" else error("a variable that cannot be passed") end' <<<"$job" > "$envfile"
              tokens="$(jq -r '.idTokens | to_entries[] | [.key, .value] | @tsv' <<<"$job")"
              while IFS=$'\\t' read -r var aud; do
                [ -n "$var" ] || continue
                value="$(mint "$aud")"
                echo "::add-mask::$value"
                export "$var=$value"
                set -- "$@" --env "$var"
              done <<<"$tokens"
              commands="$(jq -r '.commands | join("\\n")' <<<"$job")"
              image="$(jq -r .image <<<"$job")"
              docker run --rm --volume "$PWD:/work" --workdir /work --env-file "$envfile" "$@" --entrypoint sh "$image" -e -c "$commands"
              rm -f "$envfile"
            )
          done
  level-4:
    name: plan:\${{ matrix.stack.name }}
    needs:
      - fetch
      - level-3
    if: needs.fetch.outputs.action == 'plan' && needs.fetch.outputs.level4 != '[]'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        stack: \${{ fromJSON(needs.fetch.outputs.level4) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - env:
          STACK: \${{ toJSON(matrix.stack) }}
        run: |-
          set -eo pipefail
          [ -n "$ACTIONS_ID_TOKEN_REQUEST_URL" ] || { echo "the job has no identity token: the workflow needs the permission id-token: write" >&2; exit 1; }
          mint() {
            curl --fail --silent --show-error --header "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$(jq -rn --arg a "$1" '$a|@uri')" | jq -er .value
          }
          for kind in plan summary; do
            job="$(jq -c --arg k "$kind" '.jobs[$k] // empty' <<<"$STACK")"
            [ -n "$job" ] || continue
            (
              set --
              envfile="$(mktemp)"
              jq -r '.env | to_entries[] | if (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | test("[\\r\\n]") | not) then "\\(.key)=\\(.value)" else error("a variable that cannot be passed") end' <<<"$job" > "$envfile"
              tokens="$(jq -r '.idTokens | to_entries[] | [.key, .value] | @tsv' <<<"$job")"
              while IFS=$'\\t' read -r var aud; do
                [ -n "$var" ] || continue
                value="$(mint "$aud")"
                echo "::add-mask::$value"
                export "$var=$value"
                set -- "$@" --env "$var"
              done <<<"$tokens"
              commands="$(jq -r '.commands | join("\\n")' <<<"$job")"
              image="$(jq -r .image <<<"$job")"
              docker run --rm --volume "$PWD:/work" --workdir /work --env-file "$envfile" "$@" --entrypoint sh "$image" -e -c "$commands"
              rm -f "$envfile"
            )
          done
  level-5:
    name: plan:\${{ matrix.stack.name }}
    needs:
      - fetch
      - level-4
    if: needs.fetch.outputs.action == 'plan' && needs.fetch.outputs.level5 != '[]'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        stack: \${{ fromJSON(needs.fetch.outputs.level5) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - env:
          STACK: \${{ toJSON(matrix.stack) }}
        run: |-
          set -eo pipefail
          [ -n "$ACTIONS_ID_TOKEN_REQUEST_URL" ] || { echo "the job has no identity token: the workflow needs the permission id-token: write" >&2; exit 1; }
          mint() {
            curl --fail --silent --show-error --header "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$(jq -rn --arg a "$1" '$a|@uri')" | jq -er .value
          }
          for kind in plan summary; do
            job="$(jq -c --arg k "$kind" '.jobs[$k] // empty' <<<"$STACK")"
            [ -n "$job" ] || continue
            (
              set --
              envfile="$(mktemp)"
              jq -r '.env | to_entries[] | if (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | test("[\\r\\n]") | not) then "\\(.key)=\\(.value)" else error("a variable that cannot be passed") end' <<<"$job" > "$envfile"
              tokens="$(jq -r '.idTokens | to_entries[] | [.key, .value] | @tsv' <<<"$job")"
              while IFS=$'\\t' read -r var aud; do
                [ -n "$var" ] || continue
                value="$(mint "$aud")"
                echo "::add-mask::$value"
                export "$var=$value"
                set -- "$@" --env "$var"
              done <<<"$tokens"
              commands="$(jq -r '.commands | join("\\n")' <<<"$job")"
              image="$(jq -r .image <<<"$job")"
              docker run --rm --volume "$PWD:/work" --workdir /work --env-file "$envfile" "$@" --entrypoint sh "$image" -e -c "$commands"
              rm -f "$envfile"
            )
          done
  apply-0:
    name: apply:\${{ matrix.stack.name }}
    needs: fetch
    if: needs.fetch.outputs.action == 'apply' && needs.fetch.outputs.level0 != '[]'
    runs-on: ubuntu-latest
    environment: orch-apply
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        stack: \${{ fromJSON(needs.fetch.outputs.level0) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: \${{ needs.fetch.outputs.sha }}
          persist-credentials: false
      - env:
          STACK: \${{ toJSON(matrix.stack) }}
        run: |-
          set -eo pipefail
          [ -n "$ACTIONS_ID_TOKEN_REQUEST_URL" ] || { echo "the job has no identity token: the workflow needs the permission id-token: write" >&2; exit 1; }
          mint() {
            curl --fail --silent --show-error --header "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$(jq -rn --arg a "$1" '$a|@uri')" | jq -er .value
          }
          jq -e '.jobs.plan and .jobs.apply and (.judged | type == "object")' <<<"$STACK" > /dev/null || { echo "the platform's plan for $(jq -r .name <<<"$STACK") has no plan job, no apply job or no judged changes: nothing was applied" >&2; exit 1; }
          for kind in plan apply; do
            job="$(jq -c --arg k "$kind" '.jobs[$k] // empty' <<<"$STACK")"
            [ -n "$job" ] || continue
            (
              set --
              envfile="$(mktemp)"
              jq -r '.env | to_entries[] | if (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | test("[\\r\\n]") | not) then "\\(.key)=\\(.value)" else error("a variable that cannot be passed") end' <<<"$job" > "$envfile"
              tokens="$(jq -r '.idTokens | to_entries[] | [.key, .value] | @tsv' <<<"$job")"
              while IFS=$'\\t' read -r var aud; do
                [ -n "$var" ] || continue
                value="$(mint "$aud")"
                echo "::add-mask::$value"
                export "$var=$value"
                set -- "$@" --env "$var"
              done <<<"$tokens"
              commands="$(jq -r '.commands | join("\\n")' <<<"$job")"
              image="$(jq -r .image <<<"$job")"
              docker run --rm --volume "$PWD:/work" --workdir /work --env-file "$envfile" "$@" --entrypoint sh "$image" -e -c "$commands"
              rm -f "$envfile"
            )
            if [ "$kind" = plan ]; then
              have="$(jq -c --arg stack "$(jq -r .name <<<"$STACK")" '(.resource_changes // []) | map(select(.change.actions != ["no-op"] and .change.actions != ["read"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index("create"))) | length), change: ($c | map(select(.change.actions == ["update"])) | length), destroy: ($c | map(select(.change.actions | index("delete"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' "$(jq -r .path <<<"$STACK")/plan.json")" || { echo "the new plan of $(jq -r .name <<<"$STACK") could not be read: nothing was applied" >&2; exit 1; }
              jq -en --argjson have "$have" --argjson want "$(jq -c .judged <<<"$STACK")" 'def norm: del(.stack) | .resources |= sort_by(.address); ($have | norm) == ($want | norm)' > /dev/null || { echo "the changes of $(jq -r .name <<<"$STACK") are not the ones that were judged: nothing was applied. Plan again." >&2; exit 1; }
            fi
          done
  apply-1:
    name: apply:\${{ matrix.stack.name }}
    needs:
      - fetch
      - apply-0
    if: needs.fetch.outputs.action == 'apply' && needs.fetch.outputs.level1 != '[]'
    runs-on: ubuntu-latest
    environment: orch-apply
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        stack: \${{ fromJSON(needs.fetch.outputs.level1) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: \${{ needs.fetch.outputs.sha }}
          persist-credentials: false
      - env:
          STACK: \${{ toJSON(matrix.stack) }}
        run: |-
          set -eo pipefail
          [ -n "$ACTIONS_ID_TOKEN_REQUEST_URL" ] || { echo "the job has no identity token: the workflow needs the permission id-token: write" >&2; exit 1; }
          mint() {
            curl --fail --silent --show-error --header "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$(jq -rn --arg a "$1" '$a|@uri')" | jq -er .value
          }
          jq -e '.jobs.plan and .jobs.apply and (.judged | type == "object")' <<<"$STACK" > /dev/null || { echo "the platform's plan for $(jq -r .name <<<"$STACK") has no plan job, no apply job or no judged changes: nothing was applied" >&2; exit 1; }
          for kind in plan apply; do
            job="$(jq -c --arg k "$kind" '.jobs[$k] // empty' <<<"$STACK")"
            [ -n "$job" ] || continue
            (
              set --
              envfile="$(mktemp)"
              jq -r '.env | to_entries[] | if (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | test("[\\r\\n]") | not) then "\\(.key)=\\(.value)" else error("a variable that cannot be passed") end' <<<"$job" > "$envfile"
              tokens="$(jq -r '.idTokens | to_entries[] | [.key, .value] | @tsv' <<<"$job")"
              while IFS=$'\\t' read -r var aud; do
                [ -n "$var" ] || continue
                value="$(mint "$aud")"
                echo "::add-mask::$value"
                export "$var=$value"
                set -- "$@" --env "$var"
              done <<<"$tokens"
              commands="$(jq -r '.commands | join("\\n")' <<<"$job")"
              image="$(jq -r .image <<<"$job")"
              docker run --rm --volume "$PWD:/work" --workdir /work --env-file "$envfile" "$@" --entrypoint sh "$image" -e -c "$commands"
              rm -f "$envfile"
            )
            if [ "$kind" = plan ]; then
              have="$(jq -c --arg stack "$(jq -r .name <<<"$STACK")" '(.resource_changes // []) | map(select(.change.actions != ["no-op"] and .change.actions != ["read"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index("create"))) | length), change: ($c | map(select(.change.actions == ["update"])) | length), destroy: ($c | map(select(.change.actions | index("delete"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' "$(jq -r .path <<<"$STACK")/plan.json")" || { echo "the new plan of $(jq -r .name <<<"$STACK") could not be read: nothing was applied" >&2; exit 1; }
              jq -en --argjson have "$have" --argjson want "$(jq -c .judged <<<"$STACK")" 'def norm: del(.stack) | .resources |= sort_by(.address); ($have | norm) == ($want | norm)' > /dev/null || { echo "the changes of $(jq -r .name <<<"$STACK") are not the ones that were judged: nothing was applied. Plan again." >&2; exit 1; }
            fi
          done
  apply-2:
    name: apply:\${{ matrix.stack.name }}
    needs:
      - fetch
      - apply-1
    if: needs.fetch.outputs.action == 'apply' && needs.fetch.outputs.level2 != '[]'
    runs-on: ubuntu-latest
    environment: orch-apply
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        stack: \${{ fromJSON(needs.fetch.outputs.level2) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: \${{ needs.fetch.outputs.sha }}
          persist-credentials: false
      - env:
          STACK: \${{ toJSON(matrix.stack) }}
        run: |-
          set -eo pipefail
          [ -n "$ACTIONS_ID_TOKEN_REQUEST_URL" ] || { echo "the job has no identity token: the workflow needs the permission id-token: write" >&2; exit 1; }
          mint() {
            curl --fail --silent --show-error --header "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$(jq -rn --arg a "$1" '$a|@uri')" | jq -er .value
          }
          jq -e '.jobs.plan and .jobs.apply and (.judged | type == "object")' <<<"$STACK" > /dev/null || { echo "the platform's plan for $(jq -r .name <<<"$STACK") has no plan job, no apply job or no judged changes: nothing was applied" >&2; exit 1; }
          for kind in plan apply; do
            job="$(jq -c --arg k "$kind" '.jobs[$k] // empty' <<<"$STACK")"
            [ -n "$job" ] || continue
            (
              set --
              envfile="$(mktemp)"
              jq -r '.env | to_entries[] | if (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | test("[\\r\\n]") | not) then "\\(.key)=\\(.value)" else error("a variable that cannot be passed") end' <<<"$job" > "$envfile"
              tokens="$(jq -r '.idTokens | to_entries[] | [.key, .value] | @tsv' <<<"$job")"
              while IFS=$'\\t' read -r var aud; do
                [ -n "$var" ] || continue
                value="$(mint "$aud")"
                echo "::add-mask::$value"
                export "$var=$value"
                set -- "$@" --env "$var"
              done <<<"$tokens"
              commands="$(jq -r '.commands | join("\\n")' <<<"$job")"
              image="$(jq -r .image <<<"$job")"
              docker run --rm --volume "$PWD:/work" --workdir /work --env-file "$envfile" "$@" --entrypoint sh "$image" -e -c "$commands"
              rm -f "$envfile"
            )
            if [ "$kind" = plan ]; then
              have="$(jq -c --arg stack "$(jq -r .name <<<"$STACK")" '(.resource_changes // []) | map(select(.change.actions != ["no-op"] and .change.actions != ["read"])) as $c | {stack: $stack, add: ($c | map(select(.change.actions | index("create"))) | length), change: ($c | map(select(.change.actions == ["update"])) | length), destroy: ($c | map(select(.change.actions | index("delete"))) | length), resources: ($c | map({address, actions: .change.actions}) | .[:500])}' "$(jq -r .path <<<"$STACK")/plan.json")" || { echo "the new plan of $(jq -r .name <<<"$STACK") could not be read: nothing was applied" >&2; exit 1; }
              jq -en --argjson have "$have" --argjson want "$(jq -c .judged <<<"$STACK")" 'def norm: del(.stack) | .resources |= sort_by(.address); ($have | norm) == ($want | norm)' > /dev/null || { echo "the changes of $(jq -r .name <<<"$STACK") are not the ones that were judged: nothing was applied. Plan again." >&2; exit 1; }
            fi
          done
