    - eval "$login"
    - "jq -c --arg stack zone '[.[] | select(.correction_details != null) | .domain as $zone | .correction_details[] | select(test(\\"^[0-9]+ records? not being deleted because of NO_PURGE:\\\\\\\\z\\") or test(\\"^[A-Z][A-Z0-9_]*\\\\\\\\(.*\\\\\\\\),?\\\\\\\\z\\") | not) | (capture(\\"^(?:\\\\\\\\+ CREATE|- DELETE|\\\\u00B1 MODIFY) (?<fqdn>[^ ]+) (?<type>[A-Z][A-Z0-9_]*)\\") // null) as $m | (if test(\\"^\\\\\\\\+ CREATE \\") or test(\\"^Ensuring zone \\") then \\"create\\" elif test(\\"^- DELETE \\") then \\"delete\\" else \\"update\\" end) as $action | {address: (if $m == null then $zone else \\"\\\\($zone)/\\\\(if $m.fqdn == $zone then \\"@\\" elif ($m.fqdn | endswith(\\".\\" + $zone)) then $m.fqdn[:-($zone | length + 1)] else $m.fqdn end)/\\\\($m.type)\\" end), actions: [$action]}] as $c | {stack: $stack, add: ($c | map(select(.actions == [\\"create\\"])) | length), change: ($c | map(select(.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.actions == [\\"delete\\"])) | length), resources: ($c | .[:500])}' dns/report.json > summary.json"
