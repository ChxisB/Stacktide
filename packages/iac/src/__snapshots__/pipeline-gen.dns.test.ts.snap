    - "{ dnscontrol print-ir > ir.json && jq -r '.domains[] | .name as $z | ((.dnsProviders // {}) | keys_unsorted | map(select(test(\\"^[A-Za-z0-9_][A-Za-z0-9_.-]*\\\\\\\\z\\"))) | first) as $k | select($k != null and ($z | test(\\"^[a-z0-9][a-z0-9.-]*\\\\\\\\z\\"))) | \\"\\\\($k) \\\\($z)\\"' ir.json > pairs.txt; } 2> import.log || { echo \\"dnscontrol could not read dnsconfig.js; its output is the import.log artifact, which developers can read\\"; exit 1; }"
    - '[ -s pairs.txt ] || { echo "dnsconfig.js declares no zone with a provider to import from"; exit 1; }'
    - mkdir -p import
    - ok=1; while read -r key zone; do dnscontrol get-zones --format=js --out="import/$zone.raw" "$key" "$zone" < /dev/null && [ -s "import/$zone.raw" ] || ok=0; done < pairs.txt > import.log 2>&1; [ "$ok" = 1 ] || { echo "dnscontrol get-zones failed; its output is the import.log artifact, which developers can read"; exit 1; }
    - ok=1; for f in import/*.raw; do sed 's/\\(NewDnsProvider("[^"]*"\\), "")/\\1)/' "$f" | awk '{ print } /^D\\(.*,$/ { print "\\tNO_PURGE,"; added = 1 } END { exit !added }' > "\${f%.raw}.js" || ok=0; done; [ "$ok" = 1 ] || { echo "a draft has no D() line to add NO_PURGE to; the drafts are in the import artifact, which developers can read"; exit 1; }
