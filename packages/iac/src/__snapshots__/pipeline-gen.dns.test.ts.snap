// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`the plan of a DNS zone snapshot 1`] = `
"# Generated by orch: a child pipeline for plan of 1 stack. Do not edit.
stages:
  - wave-0
  - summary
plan:zone:
  stage: wave-0
  image:
    name: dnscontrol/dnscontrol:5.5.0
    entrypoint:
      - ""
  resource_group: stack-zone
  needs: []
  interruptible: true
  artifacts:
    paths:
      - dns/report.json
      - dns/preview.txt
      - dns/ir.json
    expire_in: 1 week
    access: developer
    when: always
  script:
    - cd dns
    - sh -c 'for v in "$@"; do [ -n "$(printenv "$v")" ] || { echo "creds.json names \\$$v, which is not set or is empty"; exit 1; }; done' sh $(grep -o '"[$][A-Za-z_][A-Za-z0-9_]*"' creds.json | tr -d '"$')
    - '{ dnscontrol check && dnscontrol preview --report report.json && dnscontrol print-ir > ir.json; } > preview.txt 2>&1 || { echo "dnscontrol failed; its output is the preview.txt artifact, which developers can read"; exit 1; }'
summary:zone:
  stage: summary
  image:
    name: registry.example.com/orch/ci-helper:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:zone
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack zone '[.[] | select(.correction_details != null) | .domain as $zone | .correction_details[] | select(test(\\"^[0-9]+ records? not being deleted because of NO_PURGE:\\\\\\\\z\\") or test(\\"^[A-Z][A-Z0-9_]*\\\\\\\\(.*\\\\\\\\),?\\\\\\\\z\\") | not) | (capture(\\"^(?:\\\\\\\\+ CREATE|- DELETE|\\\\u00B1 MODIFY) (?<fqdn>[^ ]+) (?<type>[A-Z][A-Z0-9_]*)\\") // null) as $m | (if test(\\"^\\\\\\\\+ CREATE \\") or test(\\"^Ensuring zone \\") then \\"create\\" elif test(\\"^- DELETE \\") then \\"delete\\" else \\"update\\" end) as $action | {address: (if $m == null then $zone else \\"\\\\($zone)/\\\\(if $m.fqdn == $zone then \\"@\\" elif ($m.fqdn | endswith(\\".\\" + $zone)) then $m.fqdn[:-($zone | length + 1)] else $m.fqdn end)/\\\\($m.type)\\" end), actions: [$action]}] as $c | {stack: $stack, add: ($c | map(select(.actions == [\\"create\\"])) | length), change: ($c | map(select(.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.actions == [\\"delete\\"])) | length), resources: ($c | .[:500])}' dns/report.json > summary.json"
    - orch dns lint < dns/ir.json > lint.json || rm -f lint.json
    - "if [ -s lint.json ] && jq -c --slurpfile lint lint.json '. + {lint: $lint[0]}' summary.json > summary.merged; then mv summary.merged summary.json; fi"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
"
`;

exports[`the plan of a DNS zone snapshot 2`] = `
"# Generated by orch: a child pipeline for plan of 1 stack. Do not edit.
stages:
  - wave-0
  - summary
plan:zone:
  stage: wave-0
  image:
    name: registry.example.com/orch/dnscontrol:5.5.0
    entrypoint:
      - ""
  resource_group: stack-zone
  environment:
    name: dns
    action: access
  variables:
    ORCH_API_URL: https://orch.example.com
  needs: []
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  interruptible: true
  artifacts:
    paths:
      - dns/report.json
      - dns/preview.txt
      - dns/ir.json
    expire_in: 1 week
    access: developer
    when: always
  script:
    - cd dns
    - login="$(orch ci login)"
    - eval "$login"
    - orch run -- sh -c 'for v in "$@"; do [ -n "$(printenv "$v")" ] || { echo "creds.json names \\$$v, which is not set or is empty"; exit 1; }; done' sh $(grep -o '"[$][A-Za-z_][A-Za-z0-9_]*"' creds.json | tr -d '"$')
    - '{ dnscontrol check && orch run -- dnscontrol preview --report report.json && dnscontrol print-ir > ir.json; } > preview.txt 2>&1 || { echo "dnscontrol failed; its output is the preview.txt artifact, which developers can read"; exit 1; }'
import:zone:
  stage: wave-0
  image:
    name: registry.example.com/orch/dnscontrol:5.5.0
    entrypoint:
      - ""
  resource_group: stack-zone
  environment:
    name: dns
    action: access
  variables:
    ORCH_API_URL: https://orch.example.com
  needs: []
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  when: manual
  allow_failure: true
  interruptible: true
  artifacts:
    paths:
      - dns/import/
      - dns/import.log
    expire_in: 1 week
    access: developer
    when: always
  script:
    - cd dns
    - login="$(orch ci login)"
    - eval "$login"
    - orch run -- sh -c 'for v in "$@"; do [ -n "$(printenv "$v")" ] || { echo "creds.json names \\$$v, which is not set or is empty"; exit 1; }; done' sh $(grep -o '"[$][A-Za-z_][A-Za-z0-9_]*"' creds.json | tr -d '"$')
    - "{ dnscontrol print-ir > ir.json && jq -r '.domains[] | .name as $z | ((.dnsProviders // {}) | keys_unsorted | map(select(test(\\"^[A-Za-z0-9_][A-Za-z0-9_.-]*\\\\\\\\z\\"))) | first) as $k | select($k != null and ($z | test(\\"^[a-z0-9][a-z0-9.-]*\\\\\\\\z\\"))) | \\"\\\\($k) \\\\($z)\\"' ir.json > pairs.txt; } 2> import.log || { echo \\"dnscontrol could not read dnsconfig.js; its output is the import.log artifact, which developers can read\\"; exit 1; }"
    - '[ -s pairs.txt ] || { echo "dnsconfig.js declares no zone with a provider to import from"; exit 1; }'
    - mkdir -p import
    - ok=1; while read -r key zone; do orch run -- dnscontrol get-zones --format=js --out="import/$zone.raw" "$key" "$zone" < /dev/null && [ -s "import/$zone.raw" ] || ok=0; done < pairs.txt > import.log 2>&1; [ "$ok" = 1 ] || { echo "dnscontrol get-zones failed; its output is the import.log artifact, which developers can read"; exit 1; }
    - ok=1; for f in import/*.raw; do sed 's/\\(NewDnsProvider("[^"]*"\\), "")/\\1)/' "$f" | awk '{ print } /^D\\(.*,$/ { print "\\tNO_PURGE,"; added = 1 } END { exit !added }' > "\${f%.raw}.js" || ok=0; done; [ "$ok" = 1 ] || { echo "a draft has no D() line to add NO_PURGE to; the drafts are in the import artifact, which developers can read"; exit 1; }
    - rm -f import/*.raw
summary:zone:
  stage: summary
  image:
    name: registry.example.com/orch/ci-helper:1.0.0
    entrypoint:
      - ""
  needs:
    - job: plan:zone
      artifacts: true
  id_tokens:
    ORCH_ID_TOKEN:
      aud: orch.example.com
  variables:
    ORCH_API_URL: https://orch.example.com
  script:
    - login="$(orch ci login)"
    - eval "$login"
    - "jq -c --arg stack zone '[.[] | select(.correction_details != null) | .domain as $zone | .correction_details[] | select(test(\\"^[0-9]+ records? not being deleted because of NO_PURGE:\\\\\\\\z\\") or test(\\"^[A-Z][A-Z0-9_]*\\\\\\\\(.*\\\\\\\\),?\\\\\\\\z\\") | not) | (capture(\\"^(?:\\\\\\\\+ CREATE|- DELETE|\\\\u00B1 MODIFY) (?<fqdn>[^ ]+) (?<type>[A-Z][A-Z0-9_]*)\\") // null) as $m | (if test(\\"^\\\\\\\\+ CREATE \\") or test(\\"^Ensuring zone \\") then \\"create\\" elif test(\\"^- DELETE \\") then \\"delete\\" else \\"update\\" end) as $action | {address: (if $m == null then $zone else \\"\\\\($zone)/\\\\(if $m.fqdn == $zone then \\"@\\" elif ($m.fqdn | endswith(\\".\\" + $zone)) then $m.fqdn[:-($zone | length + 1)] else $m.fqdn end)/\\\\($m.type)\\" end), actions: [$action]}] as $c | {stack: $stack, add: ($c | map(select(.actions == [\\"create\\"])) | length), change: ($c | map(select(.actions == [\\"update\\"])) | length), destroy: ($c | map(select(.actions == [\\"delete\\"])) | length), resources: ($c | .[:500])}' dns/report.json > summary.json"
    - orch dns lint < dns/ir.json > lint.json || rm -f lint.json
    - "if [ -s lint.json ] && jq -c --slurpfile lint lint.json '. + {lint: $lint[0]}' summary.json > summary.merged; then mv summary.merged summary.json; fi"
    - 'curl --fail --silent --show-error --request POST --header "Authorization: Bearer $ORCH_TOKEN" --header "Content-Type: application/json" --data @summary.json "$ORCH_API_URL/runs/0b9e5bd2/plan-summary"'
"
`;

exports[`the apply of a DNS zone (DNS-5) snapshot 1`] = `
"# Generated by orch: a child pipeline for apply of 1 stack. Do not edit.
stages:
  - wave-0
apply:zone:
  stage: wave-0
  image:
    name: registry.example.com/orch/dnscontrol:5.5.0
    entrypoint:
      - ""
  resource_group: stack-zone
  needs: []
  artifacts:
    paths:
      - dns/preview.txt
      - dns/push.txt
    expire_in: 1 week
    access: developer
    when: always
  script:
    - cd dns
    - sh -c 'for v in "$@"; do [ -n "$(printenv "$v")" ] || { echo "creds.json names \\$$v, which is not set or is empty"; exit 1; }; done' sh $(grep -o '"[$][A-Za-z_][A-Za-z0-9_]*"' creds.json | tr -d '"$')
    - 'wget -q --header "JOB-TOKEN: $CI_JOB_TOKEN" -O plan-report.json "$CI_API_V4_URL/projects/$CI_PROJECT_ID/jobs/7/artifacts/dns/report.json"'
    - jq -n -c 'input | (if type == "array" then . else error("not a report") end) | [.[] | .domain as $z | (.correction_details // [])[] | [$z, .]] | sort' plan-report.json > planned.txt
    - '{ dnscontrol check && dnscontrol preview --report report.json; } > preview.txt 2>&1 || { echo "dnscontrol failed; its output is the preview.txt artifact, which developers can read"; exit 1; }'
    - jq -n -c 'input | (if type == "array" then . else error("not a report") end) | [.[] | .domain as $z | (.correction_details // [])[] | [$z, .]] | sort' report.json > current.txt
    - "cmp -s planned.txt current.txt || { echo \\"the zone's changes are not the ones that were planned: nothing was pushed. Plan again.\\"; exit 1; }"
    - dnscontrol push > push.txt 2>&1 || { echo "dnscontrol push failed; its output is the push.txt artifact, which developers can read"; exit 1; }
"
`;

