# Local development defaults only. These are throwaway credentials for a database
# bound to 127.0.0.1. Never reuse them anywhere else. Real settings go in .env (git-ignored).
POSTGRES_USER=orch
POSTGRES_PASSWORD=orch
POSTGRES_DB=orch
# 5433, not 5432: leaves the default port free for other local Postgres instances.
POSTGRES_PORT=5433
DATABASE_URL=postgres://orch:orch@localhost:5433/orch
# Opt-in real GitLab contract run (see README). Leave unset: setting GITLAB_E2E_URL turns it on.
# GITLAB_E2E_URL, GITLAB_E2E_TOKEN, GITLAB_E2E_GROUP, GITLAB_E2E_PROJECT, GITLAB_E2E_ALLOW_WRITES=yes
# Master keys for secrets at rest (packages/crypto), first entry is current: "k1:<base64 of 32 random bytes>".
# Generate one with `openssl rand -base64 32`. No default is given on purpose: put the real value in .env.
# ORCH_MASTER_KEYS=k1:...
# Sign in with GitLab (all four or none). Register a GitLab application with scope read_user and this redirect URI.
# An https redirect URI makes the session cookies Secure. Put the real secret in .env, never here.
# GITLAB_URL=https://gitlab.example.com
# GITLAB_OAUTH_CLIENT_ID=...
# GITLAB_OAUTH_CLIENT_SECRET=...
# GITLAB_OAUTH_REDIRECT_URI=https://orch.example.com/auth/callback
# Roles come from GitLab membership: a token with scope read_api that is a member (or an admin) of every
# linked group and project. Needs GITLAB_URL. Without it nobody holds a role. Put the real token in .env.
# GITLAB_MEMBERSHIP_TOKEN=...
# CI jobs swap their GitLab id_token for a short-lived token (POST /auth/ci/exchange). The value is the `aud`
# the job asks for in `id_tokens:`; the issuer is GITLAB_URL. Without it the exchange answers 503.
# ORCH_CI_AUDIENCE=orch.example.com
# `bun run dev` sets ORCH_DEV_AUTH=1: no sign-in, every caller may do anything. The API refuses it outside
# NODE_ENV development/test and on a non-loopback HOST. Never put it in .env.
# GitLab user ids (comma separated) that may create organizations; everyone else needs a GitLab role (GITLAB_MEMBERSHIP_TOKEN).
# ORCH_PLATFORM_ADMIN_GITLAB_IDS=1,2
