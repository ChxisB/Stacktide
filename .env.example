# Local development defaults only. These are throwaway credentials for a database
# bound to 127.0.0.1. Never reuse them anywhere else. Real settings go in .env (git-ignored).
POSTGRES_USER=orch
POSTGRES_PASSWORD=orch
POSTGRES_DB=orch
# 5433, not 5432: leaves the default port free for other local Postgres instances.
POSTGRES_PORT=5433
DATABASE_URL=postgres://orch:orch@localhost:5433/orch
# Opt-in real GitLab contract run (see README). Leave unset: setting GITLAB_E2E_URL turns it on.
# GITLAB_E2E_URL, GITLAB_E2E_TOKEN, GITLAB_E2E_GROUP, GITLAB_E2E_PROJECT, GITLAB_E2E_ALLOW_WRITES=yes
# Master keys for secrets at rest (packages/crypto), first entry is current: "k1:<base64 of 32 random bytes>".
# Generate one with `openssl rand -base64 32`. No default is given on purpose: put the real value in .env.
# ORCH_MASTER_KEYS=k1:...
# Sign in with GitLab (all four or none). Register a GitLab application with scope read_user and this redirect URI.
# An https redirect URI makes the session cookies Secure. Put the real secret in .env, never here.
# GITLAB_URL=https://gitlab.example.com
# GITLAB_OAUTH_CLIENT_ID=...
# GITLAB_OAUTH_CLIENT_SECRET=...
# GITLAB_OAUTH_REDIRECT_URI=https://orch.example.com/auth/callback
# Sign in through an organization's own identity provider (OIDC, ADR-0016): the address the provider sends people back to.
# Register it as the redirect URI of the client the provider gives each organization. Works with or without GitLab sign-in.
# ORCH_SSO_REDIRECT_URI=https://orch.example.com/auth/sso/callback
# Roles come from GitLab membership: a token with scope read_api that is a member (or an admin) of every
# linked group and project. Needs GITLAB_URL. Without it nobody holds a role. Put the real token in .env.
# The worker reads GITLAB_URL and GITLAB_MEMBERSHIP_TOKEN too: they decide who may write `orch plan` / `orch apply` in a merge request note.
# GITLAB_MEMBERSHIP_TOKEN=...
# CI jobs swap their GitLab id_token for a short-lived token (POST /auth/ci/exchange). The value is the `aud`
# the job asks for in `id_tokens:`; the issuer is GITLAB_URL. Without it the exchange answers 503.
# ORCH_CI_AUDIENCE=orch.example.com
# Merge request plans (worker; needs ORCH_MASTER_KEYS and ORCH_CI_AUDIENCE above): where CI jobs reach this API,
# and an image that has `orch`, `curl` and `jq` for the job that posts a plan's counts. Terragrunt has no default
# image: ORCH_TERRAGRUNT_IMAGE is its repository without a tag (the stack's version is the tag). The API reads it too,
# to start the apply of a Terragrunt stack: give both the same value. See docs/iac.md.
# The API reads ORCH_API_URL (and ORCH_CI_AUDIENCE) too, to start the apply of a stack whose state is on the platform.
# ORCH_API_URL=https://orch.example.com
# ORCH_HELPER_IMAGE=registry.example.com/platform/orch-helper:1
# Policy sets (worker; docs/iac.md): an image with `orch`, `curl`, `jq`, `tar` and `conftest`, for the summary job of a stack a set judges.
# Without it a stack that has a set's tag is not planned, and the merge request says so.
# ORCH_POLICY_IMAGE=registry.example.com/platform/orch-policy:1
# Cost limits (worker; docs/iac.md): an image with `infracost` and `jq`, for the estimate job of a stack a limit reaches. The runner needs
# INFRACOST_API_KEY as a CI/CD variable (never here). Without the image nothing is estimated and the apply of a stack under a limit is denied.
# ORCH_COST_IMAGE=registry.example.com/platform/orch-cost:1
# ORCH_TERRAGRUNT_IMAGE=registry.example.com/platform/terragrunt
# Drift checks of stacks that say `drift_every` in their stack.yml (worker; same settings as merge request plans): how often
# every project with stacks is looked at for a stack that is due. 0 switches them off; otherwise at least 60. Default 3600.
# STACK_DRIFT_CHECK_SECONDS=3600
# Audit log retention (worker; docs/audit.md): how often the events past their organization's retention are deleted.
# An organization keeps its events for ever until an owner sets a retention. 0 switches the purge off; otherwise at least 60. Default 3600.
# AUDIT_PURGE_SECONDS=3600
# Change requests (worker; docs/change-requests.md): how often requests nobody decided within 7 days are closed and their
# sealed values dropped. A lapsed request cannot be approved whether or not this has run. 0 switches it off; otherwise at least 60. Default 300.
# CHANGE_REQUEST_EXPIRE_SECONDS=300
# Audit forwarding (worker, needs ORCH_MASTER_KEYS; docs/audit.md): how often the audit log is handed to the sinks that were told
# to take it. 0 switches forwarding off; otherwise at least 10. Default 30.
# AUDIT_FORWARD_SECONDS=30
# Secret rotation (worker, needs ORCH_MASTER_KEYS; docs/rotation.md): how often secrets due for rotation are rotated and
# replaced credentials past their grace are revoked. 0 switches rotation off; otherwise at least 60. Default 300.
# ROTATION_CHECK_SECONDS=300
# A stack with `environment:` in its stack.yml gets that environment's variables as TF_VAR_* (docs/iac.md): its plan job
# runs `orch`, so the tool needs an image with the tool AND orch. ORCH_TERRAFORM_IMAGE / ORCH_TOFU_IMAGE are such images
# (repository without a tag), for the worker and the API alike. They replace the default image of every stack of that tool.
# ORCH_TERRAFORM_IMAGE=registry.example.com/platform/terraform-orch
# ORCH_TOFU_IMAGE=registry.example.com/platform/tofu-orch
# Guardrails (API and worker; docs/guardrails.md): rules a plan is checked against. ORCH_GUARDRAILS_OFF switches rules off (comma list of
# production-secret-protected, production-variable-protected). ORCH_PRODUCTION_SCOPES names the production scopes (literal, no wildcards).
# ORCH_GUARDRAILS_OFF=production-variable-protected
# ORCH_PRODUCTION_SCOPES=production,prod
# Target connections of type aws_assume_role (docs/adr/0013-target-credentials.md): the platform's own AWS identity, which does nothing
# but sts:AssumeRole into the role a connection names. Without these such a connection answers 503. Never a role that can touch resources.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# GET /metrics (Prometheus text) answers only to `Authorization: Bearer <this>`; unset, it answers 404. At least 32 characters:
# `openssl rand -hex 32`. Put the real value in .env.
# ORCH_METRICS_TOKEN=
# `bun run dev` sets ORCH_DEV_AUTH=1: no sign-in, every caller may do anything. The API refuses it outside
# NODE_ENV development/test and on a non-loopback HOST. Never put it in .env.
# GitLab user ids (comma separated) that may create organizations; everyone else needs a GitLab role (GITLAB_MEMBERSHIP_TOKEN).
# ORCH_PLATFORM_ADMIN_GITLAB_IDS=1,2
# Edge hardening (docs/hardening.md). Security headers, the body cap and the rate limits are always on.
# Browser origins that may call the API with the session cookie, comma separated, exact (https://app.example.com: no path, no slash).
# Left out: none (the page and the API share one origin, as `bun run dev` does).
# ORCH_CORS_ORIGINS=https://app.example.com
# The largest request body in bytes (1 MiB to 64 MiB). Default 2 MiB.
# ORCH_MAX_BODY_BYTES=2097152
# How many reverse proxies in front of the API each append the client's address to X-Forwarded-For (0 to 5). 0: the connection's
# peer is the client and X-Forwarded-For is ignored. Set it to the real number, or all clients behind a proxy share one limit.
# ORCH_TRUSTED_PROXY_HOPS=0
# Multiplies every rate limit (0.1 to 100). Raise it when many runners or GitLab webhooks share one address.
# ORCH_RATE_LIMIT_SCALE=1
