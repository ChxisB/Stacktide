{
  "name": "devops-orchastrature",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "ORCH_DEV_AUTH=1 bun --env-file=.env.example --watch apps/api/src/index.ts",
    "worker": "bun --env-file=.env.example --watch apps/api/src/worker-main.ts",
    "dev:db": "docker compose --env-file .env.example up -d --wait db",
    "db:generate": "cd packages/db && bunx drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.example packages/db/src/migrate.ts",
    "openapi": "bun apps/api/src/gen-openapi.ts",
    "release:build": "bun apps/cli/release.ts",
    "cli:build": "mkdir -p dist && cd dist && bun build --compile ../apps/cli/src/main.ts --outfile orch && rm -f .*.bun-build",
    "web": "bun apps/web/src/server.ts",
    "templates:include": "bun packages/pipelines/src/include-files.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "lint": "biome check .",
    "test": "bun test --env-file=.env.example && cd apps/web && bun test --env-file=../../.env.example",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
