{
  "name": "devops-orchastrature",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:db": "docker compose --env-file .env.example up -d --wait db",
    "db:generate": "cd packages/db && drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.example packages/db/src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test --env-file=.env.example",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
