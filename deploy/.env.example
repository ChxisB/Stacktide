# Settings for deploy/compose.yml. Copy to deploy/.env (git-ignored) and fill in; never commit the copy.
# Every variable is explained in docs/self-host.md. A line you do not need stays commented out: an empty value is an error.

# The database password (the user and database are both `orch`). Pick a long random one: `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Secrets at rest are sealed under these keys: `k1:<base64 of 32 random bytes>` (`openssl rand -base64 32`).
# Back this up apart from the database dump: without it every secret is lost (docs/runbook-keys-and-backup.md).
ORCH_MASTER_KEYS=

# Sign in with GitLab (all four, or nobody can sign in). Register an application with scope read_user; its redirect URI
# is the public address of the web page + /auth/callback. An https address makes the session cookies Secure.
GITLAB_URL=https://gitlab.example.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=https://stacktide.example.com/auth/callback
# A GitLab token with scope read_api that is a member (or admin) of every linked group and project: it decides who holds a role.
# GITLAB_MEMBERSHIP_TOKEN=
# GitLab user ids (comma separated) that may create organizations.
# ORCH_PLATFORM_ADMIN_GITLAB_IDS=1

# How many proxies append the client's address to X-Forwarded-For: 1 is the web page alone, 2 adds a TLS proxy in front of it.
ORCH_TRUSTED_PROXY_HOPS=1
# Where CI jobs reach this API, and the audience their id_token asks for (see docs/ci.md).
# ORCH_API_URL=https://stacktide.example.com
# ORCH_CI_AUDIENCE=stacktide.example.com
# GET /metrics answers only to `Authorization: Bearer <this>` (at least 32 characters: `openssl rand -hex 32`).
# ORCH_METRICS_TOKEN=

# The web page's port on the host (loopback only) and the image to run (default ghcr.io/chxisb/stacktide:latest).
# WEB_PORT=3001
# ORCH_IMAGE=ghcr.io/chxisb/stacktide:0.1.0
